# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 푸시 테스트 구독/예약 저장소 (서버 전용 영속 볼륨)
/.data/
/certificates/

# Android 테스트 빌드와 기기별 공개 설정
/android/**/.gradle/
/android/**/build/
/android/**/local.properties
/android/**/google-services.json
/android/**/src/main/res/values/firebase-config.xml
/android/**/src/debug/res/raw/push_test_ca.crt
*.keystore
*.jks
