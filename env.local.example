# DX API/이미지 주소는 utils/dx-api.ts에서 실제 페이지 origin으로 자동 선택한다.
# http://192.168.2.147:3000 → http://192.168.2.147:24828
# 나머지 주소 → https://gapi.dxsplatform.com
# NEXT_PUBLIC_DX_API_BASE_URL, NEXT_PUBLIC_DX_IMAGE_BASE_URL,
# NEXT_PUBLIC_LAB_API_BASE, NEXT_PUBLIC_PRODUCTION_PLAN_API_BASE는 사용하지 않는다.
NEXT_PUBLIC_MATERIAL_CAMERA_HOSTS=10.172.167.185,192.168.0.54

# 발포 공정 센서(GR*_002_AI2.php) 원본 서버.
# 서버에서만 호출하므로 NEXT_PUBLIC_ 접두어를 붙이지 않는다(사내 IP 비노출).
FOAMING_SENSOR_BASE_URL=http://192.168.0.237:8080/htdocs/rootsite/dashboard/admin

# 운송 2D 지도는 키가 필요 없는 OpenFreeMap 벡터 지도를 사용한다.
# 3D 바닥 지도: 미설정이면 OpenStreetMap, CARTO 사용 시 사이트용 공개 키 지정 후 재시작/재빌드.
# NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=

# PWA 푸시 테스트: 기본 비활성. docs/push-test.md와 npm run push:setup 참고.
# 테스트 환경에서만 APP_ENV=test / PUSH_TEST_ENABLED=true로 함께 활성화한다.
APP_ENV=development
PUSH_TEST_ENABLED=false
# PUSH_TEST_ORIGIN=https://dxs-test.internal
# PUSH_TEST_DB_PATH=./.data/push-test.sqlite
# PUSH_TEST_VAPID_PUBLIC_KEY=
# PUSH_TEST_VAPID_PRIVATE_KEY=
# PUSH_TEST_VAPID_SUBJECT=mailto:admin@example.com
# PUSH_TEST_SESSION_SECRET=
# PUSH_TEST_USERS_JSON=
# APK 푸시 발송용 서비스 계정 JSON. 서버에만 설정하고 NEXT_PUBLIC_을 붙이지 않는다.
# PUSH_TEST_FCM_SERVICE_ACCOUNT_JSON=
